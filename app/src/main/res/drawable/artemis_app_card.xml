<?xml version="1.0" encoding="utf-8"?>
<!-- Artemis: an app card's shape. The card clips its art to it (AppGridAdapter), so art, tile and ring
     (artemis_app_card_ring) share one rounded outline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@dimen/artemis_card_radius"/>
    <solid android:color="@color/artemis_navy_light"/>
</shape>
