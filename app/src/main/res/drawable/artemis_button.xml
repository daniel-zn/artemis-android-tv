<?xml version="1.0" encoding="utf-8"?>
<!-- A button for the remote: lifted and ringed in gold when focused; gold when selected (the mode in use). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/artemis_gold" />
            <stroke android:width="3dp" android:color="@color/artemis_text" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/artemis_navy_light" />
            <stroke android:width="3dp" android:color="@color/artemis_gold" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/artemis_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
