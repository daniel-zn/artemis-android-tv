<?xml version="1.0" encoding="utf-8"?>
<!-- A red button (Cancel, Disconnect, Stop): ringed in white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/artemis_red" />
            <stroke android:width="3dp" android:color="@color/artemis_text" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#B3E5484D" />
        </shape>
    </item>
</selector>
