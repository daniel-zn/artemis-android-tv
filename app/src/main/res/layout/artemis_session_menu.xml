<?xml version="1.0" encoding="utf-8"?>
<!-- The session menu (Back during a session): a panel on the right, over the stream. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/artemisMenuRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <ScrollView
        android:id="@+id/artemisMenuPanel"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/artemis_panel"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/artemisMenuTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/artemis_text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/artemisMenuSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/artemis_text_dim"
                android:textSize="15sp" />

            <TextView android:id="@+id/artemisMenuResume" style="@style/ArtemisButton"
                android:layout_marginTop="18dp" android:text="@string/artemis_menu_resume" />
            <TextView android:id="@+id/artemisMenuKeyboard" style="@style/ArtemisButton"
                android:text="@string/artemis_menu_keyboard" />

            <TextView style="@style/ArtemisMenuHeading" android:text="@string/artemis_menu_dpad" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginLeft="-4dp"
                android:layout_marginRight="-4dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/artemisMenuModePointer" style="@style/ArtemisButton.Small"
                    android:text="@string/artemis_mode_pointer" />
                <TextView android:id="@+id/artemisMenuModeScroll" style="@style/ArtemisButton.Small"
                    android:text="@string/artemis_mode_scroll" />
                <TextView android:id="@+id/artemisMenuModeArrows" style="@style/ArtemisButton.Small"
                    android:text="@string/artemis_mode_arrows" />
            </LinearLayout>
            <TextView android:id="@+id/artemisMenuHoldLeft" style="@style/ArtemisButton"
                android:text="@string/artemis_menu_hold_left" />

            <TextView style="@style/ArtemisMenuHeading" android:text="@string/artemis_menu_keys" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginLeft="-4dp"
                android:layout_marginRight="-4dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/artemisMenuKeyEsc" style="@style/ArtemisButton.Small"
                    android:text="@string/artemis_key_esc" />
                <TextView android:id="@+id/artemisMenuKeyWin" style="@style/ArtemisButton.Small"
                    android:text="@string/artemis_key_windows" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginLeft="-4dp"
                android:layout_marginRight="-4dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/artemisMenuKeyAltTab" style="@style/ArtemisButton.Small"
                    android:text="@string/artemis_key_alt_tab" />
                <TextView android:id="@+id/artemisMenuKeyCad" style="@style/ArtemisButton.Small"
                    android:text="@string/artemis_key_ctrl_alt_delete" />
            </LinearLayout>

            <TextView style="@style/ArtemisMenuHeading" android:text="@string/artemis_menu_session" />
            <TextView android:id="@+id/artemisMenuMic" style="@style/ArtemisButton"
                android:visibility="gone" />
            <TextView android:id="@+id/artemisMenuStats" style="@style/ArtemisButton" />
            <TextView android:id="@+id/artemisMenuDisconnect" style="@style/ArtemisButton.Danger"
                android:text="@string/artemis_menu_disconnect" />
            <TextView android:id="@+id/artemisMenuStop" style="@style/ArtemisButton.Danger" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
