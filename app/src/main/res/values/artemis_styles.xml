<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ArtemisButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:background">@drawable/artemis_button</item>
        <item name="android:textColor">@color/artemis_button_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ArtemisButton.Small">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:layout_marginRight">4dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ArtemisButton.Danger">
        <item name="android:background">@drawable/artemis_button_danger</item>
        <item name="android:textColor">@color/artemis_text</item>
    </style>

    <style name="ArtemisMenuHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:textColor">@color/artemis_text_dim</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
